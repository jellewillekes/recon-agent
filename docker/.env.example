# Copy to docker/.env (gitignored) and fill in. docker compose reads it
# automatically from this directory.
#
# POSTGRES_PASSWORD is interpolated into DATABASE_URL unescaped, so stick to
# letters and digits. `openssl rand -hex 16` gives a suitable value.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Host port for Postgres, if something else already listens on 5432. Point
# DATABASE_URL for host-side commands (recon.cli edgar index-text) at it.
# POSTGRES_HOST_PORT=55432

# Only needed to actually serve /investigate; /healthz and /readyz work without it.
CLAUDE_CODE_OAUTH_TOKEN=
